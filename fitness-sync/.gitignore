# ══════════════════ fitness-sync — git ignore ══════════════════
# Rule of thumb: the repo ships CODE + config templates.
# Anything per-host, personal, or a secret lives in the bind mount and is
# regenerated on each host. Never commit it.

# ── SECRET: live Garmin OAuth tokenstore (NEVER commit) ──
garmin/tokens.txt/
garmin/tokens.txt
# legacy path from an old layout — kept so it can't slip in
data/garmin/tokens

# ── local config / credentials (per-host) ──
.env

# ── personal health + training data (per-host) ──
# SQLite is now the single source of truth (see app/db.py) — everything the container
# and the web UI write lives in this one file. Keep the dir, drop the personal content.
data/fitness.db
data/fitness.db-*
data/backups/
!data/.gitkeep

# legacy CSVs (pre-SQLite layout) — still ignored in case an old checkout has them
body.csv
garmin/weight.csv
garmin/metrics.csv
rollout.csv
hevy/inbox/*.csv
!hevy/inbox/.gitkeep

# ── one-off Garmin data-surface discovery dump (explore_garmin.py, personal data) ──
garmin_explore_output.json

# ── backups + scratch (regenerable, not part of the deploy) ──
*.bak
*.bak.*
garmin/.bak/
_probe_*.py

# ── python ──
.venv/
__pycache__/
*.pyc

# ── os noise ──
.DS_Store
