# COPY to .env and fill.  .env is gitignored + dockerignored — do NOT commit.
#
# AUTH MODEL
#   The container authenticates to Garmin via the TOKENSTORE
#   (garmin/tokens.txt/garmin_tokens.json, on the bind mount), NOT these creds.
#   GARMIN_EMAIL / GARMIN_PASSWORD are ONLY for the ONE-TIME `--mode init` MFA
#   login. After that the tokenstore refreshes silently. The long-running
#   container never sees your password.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the tokenstore lives (inside the container; same relative path on host
# via the ./:/app bind mount).
GARMIN_TOKENSTORE=/app/garmin/tokens.txt

# Garmin lookback window for `--mode pull` (days). 30 comfortably covers the
# 7-day moving-average window the rollup needs.
GARMIN_DAYS=30

# Backfill window (days) for `--mode watch`'s per-day calls (resting HR, kcal, SpO2,
# respiration, floors, HRV). Each day costs 2 API calls now (get_user_summary +
# get_hrv_data) — keep this modest; a live account has already been observed hitting
# Garmin's login rate limit (429), so don't raise this casually.
GARMIN_METRICS_DAYS=7

# Loop cadence for Garmin-pull + rollup. 6h keeps well under any Garmin 429
# login-spacing limit.
SYNC_INTERVAL_HOURS=6

# SQLite DB path (single source of truth for body/watch/workout/log/notes data).
# Default lands inside the bind-mounted tree, so it persists across rebuilds like the
# old CSVs did. Rarely needs changing.
DB_PATH=/app/data/fitness.db

# AUTH MODEL (web UI + API + LLM callers all use the same single-user HTTP Basic
# credential). REQUIRED — the app refuses requests (503) if these are unset. Pick your
# own values; there is no default.
AUTH_USER=
AUTH_PASSWORD=

# Port uvicorn listens on inside the container.
PORT=8000

# Optional: push notifications via ntfy (ntfy.sh or self-hosted) for a new PR, a
# readiness dip, or a broken meal streak. Leave blank to disable — nothing requires it.
# e.g. https://ntfy.sh/your-private-topic-name
NTFY_URL=
