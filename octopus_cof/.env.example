OCTOPUS_EMAIL=you@example.com
OCTOPUS_PASSWORD=your_password_here
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXXXX

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# How often to poll in seconds (60 = 1 minute)
POLL_INTERVAL=60

# Active window — only poll between these hours (local server time)
WINDOW_START_HOUR=4
WINDOW_END_HOUR=9

# Optional: target a specific offer ("nero", "greggs"). Unset = claim first available.
# OFFER_TARGET=greggs
